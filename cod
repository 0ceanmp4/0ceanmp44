<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>0cean.mp4</title>
    <style>
        :root {
            color-scheme: light;
            --paper: #c9f2f4;
            --ink: #12345b;
            --muted: #42627f;
            --accent: #006f9f;
            --highlight: #f7ffff;
            --line: #70b8d1;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            padding: 2rem 1.25rem;
            background:
                repeating-radial-gradient(ellipse at 15% 115%, transparent 0 2.2rem, rgba(255, 255, 255, 0.38) 2.3rem 2.5rem, transparent 2.6rem 4.4rem),
                repeating-radial-gradient(ellipse at 85% 105%, transparent 0 3rem, rgba(0, 111, 159, 0.16) 3.1rem 3.3rem, transparent 3.4rem 5.8rem),
                linear-gradient(135deg, #dffcff 0%, #8dd5e5 48%, #c9e9ff 100%);
            color: var(--ink);
            font-family: "Trebuchet MS", Verdana, sans-serif;
            line-height: 1.6;
        }

        .site-shell {
            width: min(100%, 74rem);
            min-height: calc(100vh - 4rem);
            margin: 0 auto;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
            gap: 2rem;
            align-items: center;
        }

        main {
            position: relative;
            width: 100%;
            padding: clamp(2rem, 6vw, 4rem) clamp(1.5rem, 5vw, 4rem);
            border: 0.35rem double var(--accent);
            outline: 1px solid var(--highlight);
            outline-offset: -0.7rem;
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(188, 237, 246, 0.82));
            box-shadow: 0.5rem 0.5rem 0 rgba(0, 76, 122, 0.2), 0 1.5rem 3rem rgba(16, 42, 67, 0.18);
            
        }

        main::before {
            content: "★ 0CEAN.MP4 ★";
            position: absolute;
            top: -0.9rem;
            left: 1.25rem;
            padding: 0.2rem 0.55rem;
            background: var(--accent);
            color: var(--highlight);
            font-family: "Courier New", monospace;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.08em;
        }

        main > p:first-child {
            margin: 0 0 1.5rem;
            color: var(--accent);
            font-family: "Courier New", monospace;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        h1 {
            max-width: 100%;
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(2.25rem, 5vw, 4.5rem);
            line-height: 0.98;
            letter-spacing: -0.03em;
            overflow-wrap: break-word;
            text-shadow: 0.12rem 0.12rem 0 var(--highlight), 0.24rem 0.24rem 0 rgba(0, 111, 159, 0.28);
        }

        main > p:last-child {
            max-width: 38rem;
            margin: 2rem 0 0;
            padding-top: 1.5rem;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 1.1rem;
        }

        a {
            color: var(--ink);
            font-weight: 700;
            text-decoration-color: var(--accent);
            text-decoration-thickness: 0.15em;
            text-underline-offset: 0.18em;
        }

        a:hover,
        a:focus-visible {
            color: var(--accent);
        }

        .posts {
            padding: 1.5rem;
            border: 0.2rem solid var(--accent);
            background: rgba(247, 255, 255, 0.72);
            box-shadow: 0.35rem 0.35rem 0 rgba(0, 76, 122, 0.2);
        }

        .posts-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .posts h2 {
            margin: 0;
            color: var(--accent);
            font-family: "Courier New", monospace;
            font-size: 1.2rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        button {
            border: 2px outset var(--highlight);
            padding: 0.35rem 0.55rem;
            background: var(--accent);
            color: var(--highlight);
            cursor: pointer;
            font: 700 0.72rem "Courier New", monospace;
            text-transform: uppercase;
        }

        button:hover,
        button:focus-visible {
            background: var(--ink);
        }

        button:active {
            border-style: inset;
        }

        .post-editor {
            margin-bottom: 1rem;
            padding: 1rem;
            border: 1px dashed var(--line);
            background: rgba(255, 255, 255, 0.55);
        }

        .post-editor[hidden] {
            display: none;
        }

        .post-editor label {
            display: block;
            margin-top: 0.7rem;
            color: var(--accent);
            font: 700 0.7rem "Courier New", monospace;
            text-transform: uppercase;
        }

        .post-editor label:first-child {
            margin-top: 0;
        }

        .post-editor input,
        .post-editor textarea {
            width: 100%;
            margin-top: 0.25rem;
            border: 1px solid var(--line);
            padding: 0.55rem;
            background: var(--highlight);
            color: var(--ink);
            font: 1rem "Trebuchet MS", Verdana, sans-serif;
        }

        .post-editor textarea {
            min-height: 5rem;
            resize: vertical;
        }

        .editor-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.8rem;
        }

        .editor-actions button[type="button"] {
            background: var(--muted);
        }

        .post {
            padding: 1rem 0;
            border-top: 1px dashed var(--line);
        }

        .post:first-of-type {
            border-top: 0;
        }

        .post h3 {
            margin: 0 0 0.25rem;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.5rem;
        }

        .post time {
            color: var(--accent);
            font-family: "Courier New", monospace;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .post p {
            margin: 0.65rem 0 0;
            color: var(--muted);
        }

        .post-actions {
            margin-top: 0.75rem;
        }

        @media (max-width: 50rem) {
            body {
                padding: 1rem;
            }

            .site-shell {
                min-height: auto;
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            main {
                padding: 2.5rem 1.25rem;
            }

            .posts {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="site-shell">
        <main>
            <p>Hello and welcome!</p>
            <h1>Hellooo!!! I'm Ocean or Finn. Either works :P</h1>
            <p>
                I do YouTube stuff. Check out my
                <a href="https://www.youtube.com/@0cean.mp44">YouTube channel</a>.
                I swear I'm trying to post, haha. I'm American.. boo.. also i use any pronouns
            </p>
        </main>

        <section class="posts" aria-labelledby="posts-title">
            <div class="posts-header">
                <h2 id="posts-title">blog / updates</h2>
                <button id="new-post" type="button">+ new post</button>
            </div>
            <form class="post-editor" id="post-editor" hidden>
                <label>Title <input id="post-title" name="title" required></label>
                <label>Date <input id="post-date" name="date" type="date" required></label>
                <label>Post <textarea id="post-body" name="body" required></textarea></label>
                <div class="editor-actions">
                    <button type="submit">save post</button>
                    <button id="cancel-post" type="button">cancel</button>
                </div>
            </form>
            <div id="posts-list"></div>
        </section>
    </div>
    <script>
        const storageKey = "ocean-mp4-posts";
        const defaultPosts = [
            { id: "welcome", date: "2026-09-05", title: "hello from the homepage", body: "Welcome to my little corner of the internet. More posts soon!" },
            { id: "online", date: "2026-08-30", title: "currently online", body: "Working on videos, playlists, and making this place feel like mine." }
        ];
        const editor = document.querySelector("#post-editor");
        const postsList = document.querySelector("#posts-list");
        const titleInput = document.querySelector("#post-title");
        const dateInput = document.querySelector("#post-date");
        const bodyInput = document.querySelector("#post-body");
        let posts = loadPosts();
        let editingId = null;

        function loadPosts() {
            try {
                const savedPosts = localStorage.getItem(storageKey);
                return savedPosts ? JSON.parse(savedPosts) : defaultPosts;
            } catch (error) {
                return defaultPosts;
            }
        }

        function savePosts() {
            localStorage.setItem(storageKey, JSON.stringify(posts));
        }

        function formatDate(date) {
            const [year, month, day] = date.split("-");
            return `${month}.${day}.${year.slice(-2)}`;
        }

        function renderPosts() {
            postsList.replaceChildren(...posts.map((post) => {
                const article = document.createElement("article");
                const date = document.createElement("time");
                const title = document.createElement("h3");
                const body = document.createElement("p");
                const actions = document.createElement("div");
                const editButton = document.createElement("button");

                article.className = "post";
                date.dateTime = post.date;
                date.textContent = formatDate(post.date);
                title.textContent = post.title;
                body.textContent = post.body;
                actions.className = "post-actions";
                editButton.type = "button";
                editButton.textContent = "edit";
                editButton.addEventListener("click", () => openEditor(post));
                actions.append(editButton);
                article.append(date, title, body, actions);
                return article;
            }));
        }

        function openEditor(post) {
            editingId = post ? post.id : null;
            titleInput.value = post ? post.title : "";
            dateInput.value = post ? post.date : new Date().toISOString().slice(0, 10);
            bodyInput.value = post ? post.body : "";
            editor.hidden = false;
            titleInput.focus();
        }

        document.querySelector("#new-post").addEventListener("click", () => openEditor());
        document.querySelector("#cancel-post").addEventListener("click", () => {
            editor.hidden = true;
        });
        editor.addEventListener("submit", (event) => {
            event.preventDefault();
            const post = {
                id: editingId || `post-${Date.now()}`,
                title: titleInput.value.trim(),
                date: dateInput.value,
                body: bodyInput.value.trim()
            };
            posts = editingId ? posts.map((savedPost) => savedPost.id === editingId ? post : savedPost) : [post, ...posts];
            savePosts();
            renderPosts();
            editor.hidden = true;
        });

        renderPosts();
    </script>
</body>
</html>